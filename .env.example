# Database — Neon connection string. Get this from your Neon project dashboard.
# Use a NEW Neon project for this, separate from buildbridge-app's database.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Ops dashboard access — a single password shared privately between the
# three founders, separate from buildbridge-app's ADMIN_PASSWORD. This is
# a simple shared-password scheme (not per-person accounts) — see
# src/lib/ops-auth.ts for why that's an acceptable tradeoff here.
OPS_PASSWORD="choose-a-long-random-password"

# Used to sign the session cookie via HMAC — generate with:
#   openssl rand -base64 32
OPS_SESSION_SECRET="generate-with-openssl-rand-base64-32"
